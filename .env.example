# Copy to .env.local for local development. Never commit real values.
# Backend secrets live in the Convex deployment, not in this file:
#   npx convex env set OPENAI_API_KEY ...
# The full inventory of backend keys is in convex/env.d.ts.

# --- Frontend (Vite) ---
# Both are written automatically by `npm run dev:backend`.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
